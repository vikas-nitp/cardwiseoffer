# Data source: "api" (calls backend) or "local" (reads bundled JSON, no network)
VITE_DATA_SOURCE=api

# Backend API base URL (used when VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://localhost:8001

# Affiliate IDs — leave blank to disable affiliate tracking
VITE_MMT_AFFILIATE_ID=
VITE_CT_AFFILIATE_ID=
VITE_6E_AFFILIATE_ID=
VITE_GIB_AFFILIATE_ID=
VITE_IXIGO_AFFILIATE_ID=
